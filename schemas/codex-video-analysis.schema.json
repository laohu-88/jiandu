{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-cut-planner.local/schemas/codex-video-analysis.schema.json",
  "title": "Codex Video Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "theme", "titles", "assets", "timeline"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectBrief": { "$ref": "#/$defs/projectBrief" },
    "contextDocumentsUsed": {
      "type": "array",
      "items": { "$ref": "#/$defs/contextDocumentUse" }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chapter" }
    },
    "storyUnits": {
      "type": "array",
      "items": { "$ref": "#/$defs/storyUnit" }
    },
    "lightCaptionPlan": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/lightCaption" }
    },
    "visualExplanationSummary": { "$ref": "#/$defs/visualExplanationSummary" },
    "platformVariants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "douyin": { "$ref": "douyin-platform-variant.schema.json" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "rationale", "confidence", "folderNameConflict"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "folderNameConflict": { "type": "boolean" }
      }
    },
    "titles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "recommended", "rationale"],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "recommended": { "type": "string", "minLength": 1, "maxLength": 80 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assetAnalysis" }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shots", "markers"],
      "properties": {
        "orientation": { "enum": ["horizontal", "vertical"] },
        "width": { "type": "integer", "minimum": 320, "multipleOf": 2 },
        "height": { "type": "integer", "minimum": 320, "multipleOf": 2 },
        "fps": { "type": "number", "minimum": 1, "maximum": 120 },
        "durationPolicy": { "$ref": "#/$defs/durationPolicy" },
        "durationException": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "chapterSegments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/chapterSegment" }
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shot" }
        },
        "markers": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/marker" }
        }
      }
    }
  },
  "$defs": {
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "projectBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDocuments",
        "theme",
        "narrativeOrder",
        "chapterRelationships",
        "styleRequirements",
        "durationRequirement",
        "hyperframesRequirement",
        "specialConstraints",
        "hardConstraints"
      ],
      "properties": {
        "sourceDocuments": { "$ref": "#/$defs/stringList" },
        "theme": { "type": ["string", "null"], "maxLength": 2000 },
        "narrativeOrder": { "$ref": "#/$defs/stringList" },
        "chapterRelationships": { "$ref": "#/$defs/stringList" },
        "styleRequirements": { "$ref": "#/$defs/stringList" },
        "durationRequirement": {
          "type": ["object", "null"],
          "properties": {
            "minSec": { "type": "number", "minimum": 0 },
            "maxSec": { "type": ["number", "null"], "minimum": 0 },
            "source": { "type": "string", "minLength": 1 }
          },
          "required": ["minSec", "maxSec", "source"],
          "additionalProperties": false
        },
        "hyperframesRequirement": { "type": ["string", "null"], "maxLength": 2000 },
        "specialConstraints": { "$ref": "#/$defs/stringList" },
        "hardConstraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chapterOrder", "allowChapterInterleave"],
          "properties": {
            "chapterOrder": { "$ref": "#/$defs/stringList" },
            "allowChapterInterleave": { "type": "boolean" }
          }
        }
      }
    },
    "contextDocumentUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "purpose"],
      "properties": {
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "chapterId": { "type": ["string", "null"], "maxLength": 100 },
        "subchapterId": { "type": ["string", "null"], "maxLength": 100 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "subchapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subchapterId", "subchapterName", "subchapterOrder", "relativePath"],
      "properties": {
        "subchapterId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subchapterName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subchapterOrder": { "type": "integer", "minimum": 1 },
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapterId", "chapterName", "chapterOrder", "relativePath", "subchapters", "purpose"],
      "properties": {
        "chapterId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "chapterName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "chapterOrder": { "type": "integer", "minimum": 1 },
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "subchapters": {
          "type": "array",
          "items": { "$ref": "#/$defs/subchapter" }
        },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "durationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minSec", "source", "rationale"],
      "properties": {
        "minSec": { "type": "number", "minimum": 0 },
        "maxSec": { "type": ["number", "null"], "minimum": 0 },
        "source": { "type": "string", "minLength": 1, "maxLength": 100 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "constrained": { "type": "boolean" }
      }
    },
    "chapterSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapterId", "startShotId", "endShotId", "startSec", "endSec", "shotCount"
      ],
      "properties": {
        "chapterId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "startShotId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "endShotId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "shotCount": { "type": "integer", "minimum": 1 }
      }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "evidenceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualEvidenceUsed", "contextEvidenceUsed", "inference"],
      "properties": {
        "visualEvidenceUsed": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "visualTextEvidenceUsed": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "audioEvidenceUsed": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "contextEvidenceUsed": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "inference": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "visualTextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceText", "language", "translatedText", "meaning", "textType",
        "confidence", "warnings"
      ],
      "properties": {
        "sourceText": { "type": "string", "minLength": 1, "maxLength": 500 },
        "language": { "type": "string", "minLength": 1, "maxLength": 32 },
        "translatedText": { "type": "string", "minLength": 1, "maxLength": 500 },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "textType": {
          "enum": [
            "subtitle", "speech_bubble", "narration", "title", "label", "sign",
            "chat", "ui", "sound_effect", "caption", "other", "uncertain"
          ]
        },
        "readingOrder": { "type": "integer", "minimum": 1 },
        "speakerOrRegion": { "type": ["string", "null"], "maxLength": 200 },
        "startTime": { "type": "number", "minimum": 0 },
        "endTime": { "type": "number", "exclusiveMinimum": 0 },
        "frameEvidence": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "warnings": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "visualTextAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "warnings"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/visualTextItem" }
        },
        "panelCount": { "type": "integer", "minimum": 0 },
        "readingDirection": { "enum": ["ltr", "rtl", "ttb", "btt", "unknown"] },
        "readingOrderUncertain": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "explanationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId", "visualSummary", "audienceNeedsExplanation",
        "explanationReason", "keyPoint", "confidence",
        "visualEvidenceUsed", "contextEvidenceUsed", "inference", "warnings"
      ],
      "properties": {
        "assetId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "storyUnitId": { "type": ["string", "null"], "maxLength": 100 },
        "visualSummary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "visualTextSummary": { "type": "string", "maxLength": 1000 },
        "audioSummary": { "type": "string", "maxLength": 1000 },
        "contextSummary": { "type": "string", "maxLength": 1000 },
        "translatedMeaning": { "type": "string", "maxLength": 1000 },
        "audienceNeedsExplanation": {
          "enum": [
            "none", "background", "translate_on_screen_text", "humor_or_twist",
            "multi_panel_dialogue", "insufficient_evidence"
          ]
        },
        "explanationReason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "keyPoint": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "setup": { "type": "string", "maxLength": 1000 },
        "payoffOrResult": { "type": "string", "maxLength": 1000 },
        "humorOrConflict": { "type": "string", "maxLength": 1000 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "visualEvidenceUsed": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "visualTextEvidenceUsed": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "audioEvidenceUsed": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "contextEvidenceUsed": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "inference": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "warnings": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "audioAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioAvailable", "audioEnabled", "audioRole", "preserveOriginalAudio", "warnings"
      ],
      "properties": {
        "audioAvailable": { "type": "boolean" },
        "audioEnabled": { "type": "boolean" },
        "audioRole": {
          "enum": ["dialogue", "ambient", "music", "reaction", "mixed", "none", "unknown"]
        },
        "speechPresent": { "type": "boolean" },
        "musicPresent": { "type": "boolean" },
        "soundEffectPresent": { "type": "boolean" },
        "audioSummary": { "type": "string", "maxLength": 1000 },
        "audioNeededForUnderstanding": { "type": "boolean" },
        "preserveOriginalAudio": { "type": "boolean" },
        "muteReason": { "type": ["string", "null"], "maxLength": 500 },
        "warnings": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "timeRangeSec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSec", "endSec"],
      "properties": {
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "label": { "type": "string", "maxLength": 200 }
      }
    },
    "videoPreservationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId", "sourceDuration", "proposedIn", "proposedOut", "selectedDuration",
        "keepRatio", "preserveFullClip", "criticalMoments", "protectedTimeRanges",
        "subtitleTimeRanges", "audioCriticalTimeRanges", "warnings"
      ],
      "properties": {
        "assetId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sourceDuration": { "type": "number", "exclusiveMinimum": 0 },
        "proposedIn": { "type": "number", "minimum": 0 },
        "proposedOut": { "type": "number", "exclusiveMinimum": 0 },
        "selectedDuration": { "type": "number", "exclusiveMinimum": 0 },
        "keepRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "preserveFullClip": { "type": "boolean" },
        "trimReason": { "type": ["string", "null"], "maxLength": 500 },
        "criticalMoments": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "protectedTimeRanges": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/timeRangeSec" }
        },
        "subtitleTimeRanges": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/timeRangeSec" }
        },
        "audioCriticalTimeRanges": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/timeRangeSec" }
        },
        "warnings": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "lightCaption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captionId", "assetId", "startTime", "endTime", "text", "purpose",
        "basedOn", "confidence", "reviewRequired", "warnings"
      ],
      "properties": {
        "captionId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "assetId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "storyUnitId": { "type": ["string", "null"], "maxLength": 100 },
        "startTime": { "type": "number", "minimum": 0 },
        "endTime": { "type": "number", "exclusiveMinimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 40 },
        "purpose": {
          "enum": ["translate", "background", "humor", "twist", "dialogue", "clarify", "none"]
        },
        "basedOn": { "type": "string", "minLength": 1, "maxLength": 500 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "reviewRequired": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "visualExplanationSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetsWithVisualText": { "type": "integer", "minimum": 0 },
        "assetsWithLightCaptions": { "type": "integer", "minimum": 0 },
        "assetsWithoutCaptions": { "type": "integer", "minimum": 0 },
        "assetsNeedingReview": { "type": "integer", "minimum": 0 },
        "videosPreservedFull": { "type": "integer", "minimum": 0 },
        "videosSuggestedTrim": { "type": "integer", "minimum": 0 },
        "videosPreserveOriginalAudio": { "type": "integer", "minimum": 0 },
        "videosSuggestedMute": { "type": "integer", "minimum": 0 },
        "lightCaptionCount": { "type": "integer", "minimum": 0 }
      }
    },
    "storyUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storyUnitId",
        "assetIds",
        "contextSourceFiles",
        "representativeAssetIds",
        "supportingAssetIds",
        "alternateAssetIds",
        "duplicateAssetIds",
        "unusableAssetIds",
        "chapterId",
        "narrativeRole",
        "selectionReason",
        "evidence",
        "confidence",
        "conflicts",
        "warnings"
      ],
      "properties": {
        "storyUnitId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "topic": { "type": ["string", "null"], "maxLength": 1000 },
        "eventKey": { "type": ["string", "null"], "maxLength": 2000 },
        "sourceItemKey": { "type": ["string", "null"], "maxLength": 300 },
        "assetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "contextSourceFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "representativeAssetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "supportingAssetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "alternateAssetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "duplicateAssetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "unusableAssetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "sourcePlatform": { "type": ["string", "null"], "maxLength": 100 },
        "sourceUrl": { "type": ["string", "null"], "maxLength": 2000 },
        "reliablePublishedAt": { "type": ["string", "null"], "maxLength": 100 },
        "chapterId": { "type": ["string", "null"], "maxLength": 100 },
        "narrativeRole": { "$ref": "#/$defs/narrativeRole" },
        "selectionReason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence": { "$ref": "#/$defs/evidenceDecision" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "conflicts": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "warnings": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "narrativeRole": {
      "enum": [
        "hook", "setup", "context", "process", "evidence", "transition",
        "result", "comparison", "conclusion", "supporting"
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSec", "endSec", "confidence", "reviewRequired"],
      "properties": {
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "reviewRequired": { "type": "boolean" }
      }
    },
    "assetAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "type",
        "semanticLabels",
        "contentSummary",
        "suggestedUse",
        "status",
        "reason",
        "ranges",
        "confidence"
      ],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["image", "video"] },
        "chapterId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subchapterId": { "type": ["string", "null"], "maxLength": 100 },
        "semanticLabels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 50 }
        },
        "contentSummary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "suggestedUse": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "status": { "enum": ["adopt", "candidate", "reject"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "ranges": { "type": "array", "items": { "$ref": "#/$defs/range" } },
        "confidence": { "$ref": "#/$defs/confidence" },
        "cleanup": { "$ref": "#/$defs/cleanupPlan" },
        "contextUsage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used", "sourceFiles", "visualEvidence", "contextEvidence"],
          "properties": {
            "used": { "type": "boolean" },
            "sourceFiles": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
            },
            "visualEvidence": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "contextEvidence": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        "storyUnitId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "narrativeRole": { "$ref": "#/$defs/narrativeRole" },
        "selectionReason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence": { "$ref": "#/$defs/evidenceDecision" },
        "conflicts": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "warnings": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "visualTextAnalysis": { "$ref": "#/$defs/visualTextAnalysis" },
        "explanationPlan": { "$ref": "#/$defs/explanationPlan" },
        "audioAnalysis": { "$ref": "#/$defs/audioAnalysis" },
        "videoPreservationPlan": { "$ref": "#/$defs/videoPreservationPlan" }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assetId",
        "inSec",
        "outSec",
        "durationSec",
        "fitMode",
        "audioMode",
        "purpose",
        "confidence",
        "reviewRequired"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "chapterId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subchapterId": { "type": ["string", "null"], "maxLength": 100 },
        "inSec": { "type": "number", "minimum": 0 },
        "outSec": { "type": "number", "exclusiveMinimum": 0 },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "fitMode": { "enum": ["contain", "cover"] },
        "audioMode": { "enum": ["keep", "mute"] },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "reviewRequired": { "type": "boolean" },
        "cleanup": { "$ref": "#/$defs/cleanupPlan" },
        "storyUnitId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "narrativeRole": { "$ref": "#/$defs/narrativeRole" },
        "selectionReason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence": { "$ref": "#/$defs/evidenceDecision" }
      }
    },
    "cleanupZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "cleanupPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision", "overlayTypes", "rationale", "method", "provider",
        "zones", "reviewRequired", "warnings"
      ],
      "properties": {
        "decision": { "enum": ["none", "crop_reframe", "derived_media", "fallback_preserve", "omit"] },
        "overlayTypes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "foreign_title", "ranking_number", "symbol", "platform_sticker",
              "watermark", "other_overlay"
            ]
          }
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "method": {
          "enum": ["none", "fcpxml_crop", "fcpxml_reframe", "ffmpeg_delogo", "ffmpeg_mask_blur", "preserve"]
        },
        "provider": {
          "enum": ["none", "fcpxml", "ffmpeg-delogo", "ffmpeg-mask-blur", "inpainting", "unavailable"]
        },
        "zones": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/cleanupZone" }
        },
        "timeRanges": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/timeRangeSec" }
        },
        "inspectedFrames": {
          "type": "array",
          "maxItems": 40,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "isCoreContent": { "type": "boolean" },
        "layout": { "type": "object" },
        "fallback": { "enum": ["preserve", "crop_reframe"] },
        "fallbackLayout": { "type": "object" },
        "resultStatus": {
          "enum": ["clean", "cleaned_by_reframe", "cleaned_by_derived_media", "unresolved"]
        },
        "reviewRequired": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeSec", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "timeSec": { "type": "number", "minimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 30 },
        "type": { "type": "string", "minLength": 1, "maxLength": 50 },
        "subtitle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "text", "durationSec", "position", "purpose", "renderAsFcpTitle"],
          "properties": {
            "enabled": { "type": "boolean" },
            "text": { "type": "string", "minLength": 1, "maxLength": 30, "pattern": "^[^\\r\\n]+$" },
            "durationSec": { "type": "number", "exclusiveMinimum": 0 },
            "position": { "enum": ["bottom-safe", "top-safe", "center"] },
            "purpose": { "type": "string", "minLength": 1, "maxLength": 200 },
            "renderAsFcpTitle": { "type": "boolean" }
          }
        }
      }
    }
  }
}
