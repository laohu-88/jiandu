{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-cut-planner.local/schemas/douyin-platform-variant.schema.json",
  "title": "Douyin Platform Variant Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "profileId",
    "planningPolicy",
    "selection",
    "videos"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "platform": { "const": "douyin" },
    "profileId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "createdBy": { "type": "string", "minLength": 1, "maxLength": 100 },
    "updatedAt": { "type": "string" },
    "planningPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixedTargetDuration",
        "fixedShotCount",
        "fixedVideoCount",
        "selectionDrivenByContent"
      ],
      "properties": {
        "fixedTargetDuration": { "const": false },
        "fixedShotCount": { "const": false },
        "fixedVideoCount": { "const": false },
        "selectionDrivenByContent": { "const": true }
      }
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/selection" }
    },
    "videos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/video" }
    }
  },
  "$defs": {
    "selectionFactors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualAppeal",
        "standaloneStrength",
        "themeConsistency",
        "mobileFit",
        "verticalPerformance",
        "contextCost",
        "visualChange",
        "originalAudioValue",
        "repetition"
      ],
      "properties": {
        "visualAppeal": { "type": "number", "minimum": 1, "maximum": 5 },
        "standaloneStrength": { "type": "number", "minimum": 1, "maximum": 5 },
        "themeConsistency": { "type": "number", "minimum": 1, "maximum": 5 },
        "mobileFit": { "type": "number", "minimum": 1, "maximum": 5 },
        "verticalPerformance": { "type": "number", "minimum": 1, "maximum": 5 },
        "contextCost": { "type": "number", "minimum": 1, "maximum": 5 },
        "visualChange": { "type": "number", "minimum": 1, "maximum": 5 },
        "originalAudioValue": { "type": "number", "minimum": 1, "maximum": 5 },
        "repetition": { "type": "number", "minimum": 1, "maximum": 5 }
      }
    },
    "selectedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSec", "endSec", "reason"],
      "properties": {
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "decision", "reason", "selectedRanges", "factors"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "decision": { "enum": ["selected", "separate", "excluded"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "selectedRanges": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectedRange" }
        },
        "factors": { "$ref": "#/$defs/selectionFactors" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "scale", "position", "crop", "subjectBounds"],
      "properties": {
        "mode": {
          "enum": [
            "native_vertical",
            "center_crop",
            "landscape_card",
            "landscape_card_blur",
            "screen_focus",
            "screen_split",
            "segmented_focus",
            "subject_track"
          ]
        },
        "scale": { "type": "number", "minimum": 0.1, "maximum": 8 },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": -1, "maximum": 1 },
            "y": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "top", "right", "bottom"],
          "properties": {
            "left": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
            "top": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
            "right": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
            "bottom": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
          }
        },
        "secondaryCrop": {
          "$ref": "#/$defs/crop"
        },
        "splitRatio": { "type": "number", "minimum": 0.25, "maximum": 0.75 },
        "subjectBounds": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "sourceTextBounds": {
          "type": "array",
          "items": { "$ref": "#/$defs/rect" }
        },
        "minReadableTextHeightPx": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "agentNote": { "type": "string", "maxLength": 1000 }
        ,
        "tracking": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/tracking" }
          ]
        }
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "subjectType",
        "status",
        "confidence",
        "sourceAspect",
        "outputAspect",
        "safeMargin",
        "sampleIntervalSec",
        "points",
        "keyframes",
        "locks",
        "manualConfirmation",
        "fallback",
        "warnings"
      ],
      "properties": {
        "enabled": { "const": true },
        "subjectType": {
          "enum": ["person", "animal", "vehicle", "moving_object", "user_region"]
        },
        "status": {
          "enum": ["tracked", "low_confidence", "fallback", "failed"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceAspect": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "outputAspect": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "safeMargin": { "type": "number", "minimum": 0, "maximum": 0.2 },
        "sampleIntervalSec": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/trackingPoint" }
        },
        "keyframes": {
          "type": "array",
          "items": { "$ref": "#/$defs/trackingKeyframe" }
        },
        "locks": {
          "type": "array",
          "items": { "$ref": "#/$defs/trackingLock" }
        },
        "manualConfirmation": {
          "enum": ["pending", "approved_continue", "corrected", "fallback"]
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "reason", "applied"],
          "properties": {
            "mode": {
              "enum": [
                "landscape_card",
                "landscape_card_blur",
                "native_vertical",
                "center_crop",
                "screen_focus",
                "screen_split",
                "segmented_focus"
              ]
            },
            "reason": { "type": "string", "maxLength": 1000 },
            "applied": { "type": "boolean" }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "trackingPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointId",
        "sourceTimeSec",
        "sourceTime",
        "bounds",
        "confidence",
        "origin",
        "locked"
      ],
      "properties": {
        "pointId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sourceTimeSec": { "type": "number", "minimum": 0 },
        "sourceTime": { "type": "string", "minLength": 2 },
        "bounds": { "$ref": "#/$defs/rect" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "origin": { "enum": ["agent", "manual"] },
        "locked": { "type": "boolean" }
      }
    },
    "trackingKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyframeId",
        "pointId",
        "sourceTimeSec",
        "sourceTime",
        "position",
        "scale",
        "crop",
        "interpolation"
      ],
      "properties": {
        "keyframeId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "pointId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sourceTimeSec": { "type": "number", "minimum": 0 },
        "sourceTime": { "type": "string", "minLength": 2 },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": -1, "maximum": 1 },
            "y": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        },
        "scale": { "type": "number", "minimum": 0.1, "maximum": 8 },
        "crop": { "$ref": "#/$defs/crop" },
        "interpolation": { "enum": ["smooth", "linear"] }
      }
    },
    "trackingLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockId", "startSec", "endSec", "pointId"],
      "properties": {
        "lockId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "pointId": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "top": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "right": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "bottom": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotId",
        "assetId",
        "inSec",
        "outSec",
        "purpose",
        "audioMode",
        "muteReason",
        "layout"
      ],
      "properties": {
        "shotId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "assetId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "inSec": { "type": "number", "minimum": 0 },
        "outSec": { "type": "number", "exclusiveMinimum": 0 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "audioMode": { "enum": ["keep", "mute"] },
        "muteReason": { "type": ["string", "null"], "maxLength": 500 },
        "layout": { "$ref": "#/$defs/layout" },
        "agentLayout": { "$ref": "#/$defs/layout" }
      }
    },
    "lightCaption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captionId",
        "assetId",
        "shotId",
        "text",
        "offsetSec",
        "durationSec",
        "position",
        "purpose",
        "basedOn",
        "required",
        "sourceLocked"
      ],
      "properties": {
        "captionId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "assetId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "shotId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "text": { "type": "string", "minLength": 1, "maxLength": 40 },
        "offsetSec": { "type": "number", "minimum": 0 },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "position": { "enum": ["bottom-safe", "top-safe", "center"] },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "enum": ["content", "context", "chapter_conclusion"] },
        "basedOn": { "type": "string", "minLength": 1, "maxLength": 500 },
        "required": { "type": "boolean" },
        "sourceLocked": { "type": "boolean" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warningId", "type", "assetId", "message"],
      "properties": {
        "warningId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "type": {
          "enum": [
            "watermark",
            "qr_code",
            "sensitive_content",
            "readability",
            "safe_zone",
            "critical_crop",
            "manual_review",
            "other"
          ]
        },
        "assetId": { "type": ["string", "null"], "maxLength": 100 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "videoId",
        "theme",
        "rationale",
        "openingAssetId",
        "naturalEnding",
        "shots",
        "lightCaptions",
        "warnings"
      ],
      "properties": {
        "videoId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
        "theme": { "type": "string", "minLength": 1, "maxLength": 200 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "openingAssetId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "naturalEnding": { "type": "string", "minLength": 1, "maxLength": 500 },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shot" }
        },
        "lightCaptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/lightCaption" }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        }
      }
    }
  }
}
